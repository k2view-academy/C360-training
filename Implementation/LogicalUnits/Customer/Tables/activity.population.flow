            - customer_id
            - activity_id
            - activity_date
            - activity_note
          keys:
            const:
          dialect:
            const: sqlite
          customer_id:
            schema: any
          activity_id:
            schema: any
          activity_date:
            schema: any
          activity_note:
            schema: any
          params:
            link:
              path: Query/result
              iterate: Iterate
  Post Load: {
    }
