stages:
  Input:
    actors:
      PopulationArgs:
        parent: PopulationArgs
        readonly: true
        in:
          customer_id:
            external: customer_id
            schema: any
            mandatory: false
          ssn:
            external: ssn
            schema: any
            mandatory: false
          first_name:
            external: first_name
            schema: any
            mandatory: false
          last_name:
            external: last_name
            schema: any
            mandatory: false
      SyncDeleteMode:
        parent: SyncDeleteMode
        in:
          interface:
            schema: any
          table:
            const: null
            external: table
  Source:
    actors:
      Query:
        parent: SourceDbQuery
        in:
          interface:
            const: CRM_DB
          sql:
            const: select * from public.customer
          parent_rows:
            link: PopulationArgs/parent_rows
        out:
          result:
            schema: '#ref'
  Stage 1: {
    }
  LU Table:
    last: 1
    actors:
      customer:
        parent: DbLoad
        in:
          interface:
            const: fabric
          schema:
            const: null
            external: schema
          table:
            const: null
            external: table
          fields:
            const:
            - customer_id
            - ssn
            - first_name
            - last_name
          keys:
            const:
          dialect:
            const: sqlite
          customer_id:
            schema: any
          ssn:
            schema: any
          first_name:
            schema: any
          last_name:
            schema: any
          params:
            link:
              path: Query/result
              iterate: Iterate
  Post Load: {
    }
schemas:
  Query.out.result:
    type: object
    properties:
      customer_id:
        type: {
          }
      ssn:
        type: {
          }
      first_name:
        type: {
          }
      last_name:
        type: {
          }
