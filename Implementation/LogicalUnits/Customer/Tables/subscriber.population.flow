stages:
  Input:
    actors:
      PopulationArgs:
        parent: PopulationArgs
        readonly: true
        in:
          subscriber_id:
            external: subscriber_id
            schema: any
            mandatory: false
          msisdn:
            external: msisdn
            schema: any
