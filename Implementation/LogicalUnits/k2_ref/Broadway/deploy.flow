stages:
  Parameters:
    remark: "This flow will run automatically during deploy.\nIt will not run in case\
      \ of soft deploy.\nIf the deploy command contains custom parameters, they can\
      \ be accessed as additional external parameters with the same name. You can\
      \ use the constants below, or use the external names in other actors. \n"
    actors:
      is_first_deploy:
        parent: Const
        remark: A boolean representing if this is the first deploy
        in:
          value:
            const: null
            external: is_first_deploy
            schema: boolean
        out:
          value:
            schema: boolean
  'True':
    dependsOn: Parameters
    actors:
      EqualsIgnoreCase:
        parent: EqualsIgnoreCase
        condition: result
        in:
          b:
            const: true
            schema: boolean
          a:
            link: is_first_deploy/value
    split: '--------------------'
  'False':
    else: true
    transactional: false
    dependsOn: Parameters
  Roles and Databases:
    dependsOn: 'True'
    actors:
      createRolesAndDbs:
        parent: InnerFlow
        in:
          flowName:
            const: createRolesAndDbs
    split: '--------------------'
  Stage 1:
    transactional: false
    dependsOn: 'False'
  Source Databases:
    dependsOn: Roles and Databases
    actors:
      createSRCDbs:
        parent: InnerFlow
        in:
          flowName:
            const: createSRCDbs
    split: '--------------------'
  Stage 2:
    transactional: false
    dependsOn: Stage 1
  'CRM    ':
    transactional: false
    dependsOn: Source Databases
    actors:
      CRM_DB:
        parent: InnerFlow
        in:
          flowName:
            const: populateDbs
          interface:
            const: CRM_DB
            schema: string
            editor:
              interfaceType:
              - database
              - CassandraLoader
              interfaces:
              - fabric
              id: com.k2view.interface
            mandatory: false
          path:
            const: DEMO/crm.sql.gz
            schema: string
            mandatory: false
    split: '--------------------'
  Stage 3:
    transactional: false
    dependsOn: Stage 2
  Add Birthday To CRM:
    transactional: false
    dependsOn: 'CRM    '
    actors:
      addBirthdayToCRM1:
        parent: InnerFlow
        in:
          flowName:
            const: addBirthdayToCRM
    split: '--------------------'
  Stage 4:
    transactional: false
    dependsOn: Stage 3
  'BILLING  ':
    transactional: false
    dependsOn: Add Birthday To CRM
    actors:
      BILLING_DB:
        parent: InnerFlow
        in:
          flowName:
            const: populateDbs
          interface:
            const: BILLING_DB
            schema: string
            editor:
              interfaceType:
              - database
              - CassandraLoader
              interfaces:
              - fabric
              id: com.k2view.interface
            mandatory: false
          path:
            const: DEMO/billing.sql.gz
            schema: string
            mandatory: false
    split: '--------------------'
  Stage 5:
    transactional: false
    dependsOn: Stage 4
  Sleep:
    dependsOn: 'BILLING  '
    actors:
      'Sleep     ':
        parent: Sleep
    split: '--------------------'
  Stage 6:
    transactional: false
    dependsOn: Stage 5
  Delete Interfaces:
    dependsOn: Sleep
    actors:
      deleteInterfaces:
        parent: InnerFlow
        in:
          flowName:
            const: deleteInterfaces
    split: '--------------------'
  Stage 7:
    transactional: false
    dependsOn: Stage 6
